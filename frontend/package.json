{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run generate:dev-init-data",
    "dev": "vite dev --port 3000",
    "generate:dev-init-data": "node scripts/generate-dev-init-data.mjs",
    "generate-api": "orval --config orval.config.ts",
