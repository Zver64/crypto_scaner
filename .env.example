# PostgreSQL. The backend safely builds its connection URL from these values.
POSTGRES_HOST=127.0.0.1
POSTGRES_USER=scanner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=scanner
POSTGRES_PORT=5432

# Backend.
TELEGRAM_BOT_TOKEN=replace-me
ADMIN_TELEGRAM_ID=123456789

# Generated locally by `npm --prefix frontend run generate:dev-init-data`.
# Keep the real value only in the gitignored .env.local file.
TELEGRAM_DEV_INIT_DATA=

# Required backend authentication setting: how old Telegram init data may be
# when the Mini App exchanges it for a session. Local development signs init
# data once when Vite starts; use 5m in production.
TELEGRAM_INIT_DATA_MAX_AGE=15m
# Optional session lifetimes: a session ends after SESSION_IDLE_TTL without
# requests and after SESSION_ABSOLUTE_TTL in any case.
SESSION_IDLE_TTL=12h
SESSION_ABSOLUTE_TTL=168h

# Optional backend settings (documented defaults shown).
HTTP_ADDRESS=127.0.0.1:8080
# Development Compose enables this; leave false for direct local or production runs.
API_DOCS_ENABLED=false
LOG_LEVEL=info
SYNC_WORKERS=4
SYNC_RETRY_ATTEMPTS=5
SHUTDOWN_TIMEOUT=15s
# Docker waits this long for the backend to stop; keep it greater than SHUTDOWN_TIMEOUT.
BACKEND_STOP_GRACE_PERIOD=30s
# Optional CoinGecko demo key. It is never logged; keyless local use is supported.
COINGECKO_DEMO_API_KEY=

# Frontend development server. Vite uses this only as its local proxy target.
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
