# Required by the server process.
DATABASE_URL=postgres://scanner:change-me@127.0.0.1:5432/scanner
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_WEBHOOK_SECRET=replace-me
ADMIN_TELEGRAM_ID=123456789
MINI_APP_URL=https://example.com/app

# Required only by the standalone webhook registration command.
PUBLIC_BASE_URL=https://example.com

# Optional process settings (documented defaults shown).
HTTP_ADDRESS=127.0.0.1:8080
LOG_LEVEL=info
TELEGRAM_INIT_DATA_MAX_AGE=15m
SYNC_WORKERS=4
SYNC_RETRY_ATTEMPTS=5
SHUTDOWN_TIMEOUT=15s
