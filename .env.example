# Local PostgreSQL. Use URL-safe values because the development commands build
# DATABASE_URL from these fields. Docker Compose and Make load this file.
POSTGRES_USER=scanner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=scanner
POSTGRES_PORT=5432

# Host port exposed by the application container.
HTTP_PORT=8080

# Required by the server process.
TELEGRAM_BOT_TOKEN=replace-me
ADMIN_TELEGRAM_ID=123456789

# Optional process settings (documented defaults shown).
HTTP_ADDRESS=127.0.0.1:8080
LOG_LEVEL=info
TELEGRAM_INIT_DATA_MAX_AGE=15m
SYNC_WORKERS=4
SYNC_RETRY_ATTEMPTS=5
SHUTDOWN_TIMEOUT=15s
