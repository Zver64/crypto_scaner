# Crypto Scanner analysis endpoints
#
# Both endpoints require fresh Telegram Mini App initData from an enabled user:
#   Authorization: tma <window.Telegram.WebApp.initData>
#
# Copy http-client.private.env.json.example to http-client.private.env.json and
# replace TELEGRAM_INIT_DATA there. The private file is ignored by Git.

@symbol = BTCUSDT

### Analyze one active symbol
# Criterion instance keys must be nonempty and unique within the request. Labels
# are presentation identity; names select reusable criterion implementations.
# @name analyzeSymbol
POST {{BASE_URL}}/api/v1/analysis/instruments/{{symbol}} HTTP/1.1
Accept: application/json
Authorization: tma {{TELEGRAM_INIT_DATA}}
Content-Type: application/json
X-Request-ID: kulala-analysis-symbol

{
  "criteria": [
    {
      "key": "daily_volatility",
      "name": "volatility",
      "label": "Daily Volatility",
      "parameters": {
        "unit": "days",
        "period": 30,
        "percentile": 80,
        "minimum_range_percent": 5
      }
    },
    {
      "key": "hourly_volatility",
      "name": "volatility",
      "label": "Hourly Volatility",
      "parameters": {
        "unit": "hours",
        "period": 60,
        "percentile": 80,
        "minimum_range_percent": 2
      }
    }
  ]
}

### Search all active symbols
# Criteria run in request order and later instances receive only survivors.
# @name searchMarket
POST {{BASE_URL}}/api/v1/analysis/market HTTP/1.1
Accept: application/json
Authorization: tma {{TELEGRAM_INIT_DATA}}
Content-Type: application/json
X-Request-ID: kulala-analysis-search

{
  "criteria": [
    {
      "key": "volatility",
      "name": "volatility",
      "label": "Volatility",
      "parameters": {
        "unit": "days",
        "period": 30,
        "percentile": 80,
        "minimum_range_percent": 3
      }
    },
    {
      "key": "market_cap",
      "name": "market_cap",
      "label": "Market Cap",
      "parameters": {
        "min_market_cap_usd": 500000000
      }
    }
  ]
}

### Validation failure example
# A blank instance key demonstrates the canonical 400 invalid_argument error.
# @name analyzeWithInvalidArguments
POST {{BASE_URL}}/api/v1/analysis/instruments/{{symbol}} HTTP/1.1
Accept: application/json
Authorization: tma {{TELEGRAM_INIT_DATA}}
Content-Type: application/json
X-Request-ID: kulala-analysis-invalid

{
  "criteria": [
    {
      "key": "",
      "name": "volatility",
      "label": "Volatility",
      "parameters": {
        "unit": "days",
        "period": 30,
        "percentile": 80,
        "minimum_range_percent": 3
      }
    }
  ]
}
